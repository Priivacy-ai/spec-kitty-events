{
  "$id": "spec-kitty-events/mission_cancelled_payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed payload for MissionCancelled events.\n\nHardened by F1-T1 (7.0.0, strict journal profile): ``extra=\"forbid\"``.\nNo ``mission_slug`` field is added \u2014 no live producer exists in\nspec-kitty/src (grep, F1 draft \u00a72.2); spec-kitty-saas only consumes it.",
  "properties": {
    "actor": {
      "description": "Actor who cancelled the mission",
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "cancelled_wp_ids": {
      "description": "WP IDs affected by cancellation",
      "items": {
        "type": "string"
      },
      "title": "Cancelled Wp Ids",
      "type": "array"
    },
    "mission_id": {
      "description": "Mission identifier",
      "minLength": 1,
      "title": "Mission Id",
      "type": "string"
    },
    "reason": {
      "description": "Reason for cancellation (required)",
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "reason",
    "actor"
  ],
  "title": "MissionCancelledPayload",
  "type": "object"
}
