{
  "$id": "spec-kitty-events/mission_closed_payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed payload for MissionClosed catalog events.\n\n``actor`` (8.0.0) mirrors ``MissionCreatedPayload.actor`` \u2014 the opaque\nidentifier of whoever closed the mission \u2014 optional for the same\nback-compat reason.",
  "properties": {
    "actor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Opaque actor identifier of who closed the mission (broadcast under the moment's ``actor`` key)",
      "title": "Actor"
    },
    "mission_number": {
      "description": "Canonical mission number",
      "minimum": 1,
      "title": "Mission Number",
      "type": "integer"
    },
    "mission_slug": {
      "description": "Canonical mission slug",
      "minLength": 1,
      "title": "Mission Slug",
      "type": "string"
    },
    "mission_type": {
      "description": "Canonical mission workflow/template type",
      "minLength": 1,
      "title": "Mission Type",
      "type": "string"
    }
  },
  "required": [
    "mission_slug",
    "mission_number",
    "mission_type"
  ],
  "title": "MissionClosedPayload",
  "type": "object"
}
