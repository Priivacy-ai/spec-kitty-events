{
  "$id": "spec-kitty-events/workspace_ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reference to a Slack-connected Team Kitty workspace.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable workspace name",
      "title": "Name"
    },
    "workspace_id": {
      "description": "Team Kitty workspace identifier",
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id"
  ],
  "title": "WorkspaceRef",
  "type": "object"
}
