{
  "$id": "spec-kitty-events/mission_completed_payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed payload for MissionCompleted events.\n\nHardened by F1-T1 (7.0.0, strict journal profile): ``extra=\"forbid\"``;\n``mission_slug`` added for the same reason as ``MissionStartedPayload``\n(live producer: ``emitter.py`` ``emit_mission_completed``).",
  "properties": {
    "actor": {
      "description": "Actor who completed the mission",
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "final_phase": {
      "description": "Last phase before completion",
      "minLength": 1,
      "title": "Final Phase",
      "type": "string"
    },
    "mission_id": {
      "description": "Mission identifier",
      "minLength": 1,
      "title": "Mission Id",
      "type": "string"
    },
    "mission_slug": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical mission slug (display/back-compat; mission_id is the identity)",
      "title": "Mission Slug"
    },
    "mission_type": {
      "description": "Mission type",
      "minLength": 1,
      "title": "Mission Type",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "mission_type",
    "final_phase",
    "actor"
  ],
  "title": "MissionCompletedPayload",
  "type": "object"
}
